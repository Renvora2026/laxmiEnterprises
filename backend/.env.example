# =================================================================
# Laxmi Enterprises Backend Configuration Template (Hostinger MySQL)
# =================================================================
PORT=5000
NODE_ENV=development

# Hostinger MySQL Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password
DB_DIALECT=mysql
DB_SSL=false

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
